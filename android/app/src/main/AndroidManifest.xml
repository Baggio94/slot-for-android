<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Required for the short-lived mDNS discovery lock during Host / Join. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Wi-Fi low latency lock held only while a Link session plays. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <queries>
        <!-- Only the explicitly supported optional status integrations. -->
        <package android:name="com.med.sleepmanager" />
        <provider android:authorities="com.med.sleepmanager.status" />
        <package android:name="com.chiller3.basicsync" />
        <package android:name="com.github.catfriend1.syncthingfork" />
        <package android:name="com.github.catfriend1.syncthingfork.debug" />
        <package android:name="com.github.catfriend1.syncthingandroid" />
        <package android:name="com.github.catfriend1.syncthingandroid.debug" />
        <provider android:authorities="com.raofflineproxy.config" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/ra_network_security_config"
        android:label="slot."
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.SlotKonkr">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- slot. as the home app. Android keeps a home app in a task of its
             own, so Home went to a second slot. when slot. had been opened
             another way (RG Rotate, 2026-11-14): this one only brings back
             the slot. already running. Never changes the home app silently;
             user explicitly grants Home role via Apps -> Set as Home. -->
        <activity
            android:name=".SlotHomeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="fyi.slot.konkr.home"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/slot_update_paths" />
        </provider>
        <!-- RG Rotate: "Lock the screen" only, so a closed Rotate can sleep.
             Its lid acts as a held key that Android repeats as user
             activity, which keeps the screen timeout from ever ending. -->
        <receiver android:name=".SlotDeviceAdmin"
            android:exported="true"
            android:label="slot."
            android:description="@string/slot_device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin"
                android:resource="@xml/slot_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <activity android:name=".AppsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>
</manifest>
