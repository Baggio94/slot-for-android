diff --git a/libs/z8lua/lpico8lib.c b/libs/z8lua/lpico8lib.c
index 6a083e2..2930b8d 100644
--- a/libs/z8lua/lpico8lib.c
+++ b/libs/z8lua/lpico8lib.c
@@ -61,7 +61,10 @@ static lua_Number sin_helper(lua_Number x) {
     // We use a lookup table of sin(x)-4x generated by PICO-8 to ensure
     // that we get the exact same results.
     auto a = ((x.bits() & 0x4000 ? ~x : x).bits() & 0x3fff) + 2;
-    auto ret = lua_Number::frombits((a >> 2 << 4) + sintable[a >> 2]);
+    // a >> 2 reaches 0x1000 (a quarter turn), one past the table, whose
+    // entries fall by 0x10 to 0x10: the missing last one is 0
+    auto i = a >> 2;
+    auto ret = lua_Number::frombits((i << 4) + (i < 0x1000 ? sintable[i] : 0));
     return x.bits() & 0x8000 ? ret : -ret;
 }
 
