+// Start the frontend's cart again. It came as bytes, so it has no file name
+// to load again. Starting it from its bytes also covers a cart whose load()
+// of another cart failed (fake-08 then holds its default cart as the loaded
+// one while the cart runs on), and does not hang on which cart object is
+// loaded, which a save state does not hold.
+void Vm::ResetCart() {
+    if (!_cartBytes.empty()) {
+        QueueCartChange(_cartBytes.data(), _cartBytes.size());
+    }
+    else {
+        QueueCartChange(CurrentCartFilename());
+    }
+}
