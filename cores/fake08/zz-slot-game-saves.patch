+void Host::setGameSaveName(std::string name) {
+    _gameSaveName = name;
+    _gameSaveKey = "";
+}
+
+// The game's own save holds its first cartdata id; another id the game
+// opens stays in cdata/ only.
+bool Host::gameSaveFor(std::string cartDataKey) {
+    if (_gameSaveName.length() == 0) return false;
+    if (_gameSaveKey.length() == 0) _gameSaveKey = cartDataKey;
+    return _gameSaveKey == cartDataKey;
+}
+
+std::string Host::getCartDataFileContents(std::string cartDataKey) {
+    if (gameSaveFor(cartDataKey)) {
+        std::string own = _logFilePrefix + _gameSaveName + ".p8d.txt";
+        if (slot_file_exists(own)) return get_file_contents(own);
+        // A game whose save was deleted starts afresh; one never saved in
+        // slot. takes the id's shared file (another cart of the game, or
+        // a save made before).
+        if (slot_file_exists(_logFilePrefix + _gameSaveName + ".p8key")) return "";
+    }
+    return get_file_contents(getCartDataFile(cartDataKey));
+}
+
+void Host::saveCartData(std::string cartDataKey, std::string contents) {
+    slot_write_text(getCartDataFile(cartDataKey), contents);
+    if (gameSaveFor(cartDataKey)) {
+        slot_write_text(_logFilePrefix + _gameSaveName + ".p8d.txt", contents);
+        slot_write_text(_logFilePrefix + _gameSaveName + ".p8key", cartDataKey);
+    }
 }
 
