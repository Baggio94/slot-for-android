--- a/app/src/main/cpp/pk_wide.c
+++ b/app/src/main/cpp/pk_wide.c
@@ -2560,7 +2560,38 @@ static int32_t edgeAccV[2][PK_WIDE_W][3];   // the top / bottom band's per colum
 static int32_t preH[2][PK_WIDE_H + 1][3], preV[2][PK_WIDE_W + 1][3];   // their running sums (a blur is a difference)
 static bool edgeAccOk;
 
+int pk_wide_dark_sides;
+
+// slot.: INTRO in EXPAND, before the game has started (pk_wide_dark_sides): the screen's background, when most of the
+// frame's outer edge is one colour (the BIOS's white, the credits' black), else black. In game, the glow as before.
+#define FLAT_SHARE 60
+static bool flatOk;
+static uint32_t flatColour;
+
+static void flatPrepare(const uint32_t* frame) {
+    uint32_t cand = 0;
+    int votes = 0, total = 0, same = 0;
+    const int n = 2 * PK_WIDE_W + 2 * PK_WIDE_H;
+    for (int pass = 0; pass < 2; pass++)
+        for (int i = 0; i < n; i++) {
+            uint32_t c = (i < PK_WIDE_W ? frame[i]
+                          : i < 2 * PK_WIDE_W ? frame[(PK_WIDE_H - 1) * PK_WIDE_W + i - PK_WIDE_W]
+                          : i < 2 * PK_WIDE_W + PK_WIDE_H ? frame[(i - 2 * PK_WIDE_W) * PK_WIDE_W]
+                          : frame[(i - 2 * PK_WIDE_W - PK_WIDE_H) * PK_WIDE_W + PK_WIDE_W - 1]) & 0x00FFFFFFu;
+            if (!pass) {
+                if (!votes) cand = c;
+                votes += c == cand ? 1 : -1;
+            } else {
+                total++;
+                same += c == cand;
+            }
+        }
+    flatOk = same * 100 >= FLAT_SHARE * total;
+    flatColour = cand;
+}
+
 static void ambientPrepare(const uint32_t* frame) {
+    if (pk_wide_dark_sides) flatPrepare(frame);
     for (int side = 0; side < 2; side++) {
         int x0 = side ? PK_WIDE_W - AMBIENT_BAND : 0, y0 = side ? PK_WIDE_H - AMBIENT_BAND : 0;
         for (int c = 0; c < 3; c++) preH[side][0][c] = preV[side][0][c] = 0;
@@ -2596,6 +2627,7 @@ static void ambientPrepare(const uint32_t* frame) {
 /** The glow at screen pixel (X, Y), off the frame; `reach` is how far the window goes past each edge (left, right,
  * top, bottom), where it's dimmest. */
 static uint32_t glowAt(const uint32_t* frame, int X, int Y, const int reach[4], uint32_t alpha) {
+    if (pk_wide_dark_sides) return (flatOk ? flatColour : 0) | alpha;
     int ox = X < 0 ? -X : X >= PK_WIDE_W ? X - PK_WIDE_W + 1 : 0;
     int oy = Y < 0 ? -Y : Y >= PK_WIDE_H ? Y - PK_WIDE_H + 1 : 0;
     bool across = ox >= oy;   // from the left / right edge, else the top / bottom one
@@ -4899,6 +4931,7 @@ static void fullDraw(const struct FullView* f) {
     PW_MARK(pw4);
     PW_ADD(2, pw3, pw4);
     if (!rawView.w) mix = 0;   // nothing drawn yet
+    if (pk_wide_dark_sides) mix = 0;   // slot.: INTRO in EXPAND, before the game has started: no scene, its rows' bands
     if (mix < 256) ambientPrepare(frame);
     else edgeAccOk = false;    // the glow starts from the edges as they are when it's next needed
     int reach[4] = { -v.x, v.x + v.w - PK_WIDE_W, -v.y, v.y + v.h - PK_WIDE_H };
