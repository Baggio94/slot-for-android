+/* slot.: mGBA's colour correction (libretro/mgba's ccLUT), on the frame handed to the frontend while the game is shown
+ * (ccFrame): never on the companion or the quick menu. A table from each RGB565 colour to its corrected one. */
+static uint16_t *ccLut, *ccOut;
+static int ccType; // 0 none, 1 the GBA's screen, 2 the GBC's
+static bool ccFrame;
+static void cc_build(int type) {
+  ccType = 0;
+  if (type <= 0)
+    return;
+  if (!ccLut)
+    ccLut = malloc(65536 * sizeof *ccLut);
+  if (!ccOut)
+    ccOut = malloc((size_t)CANVAS_MAX_W * CANVAS_MAX_H * sizeof *ccOut);
+  if (!ccLut || !ccOut)
+    return;
+  const float lum = 0.94f, r0 = 0.82f, g0 = 0.665f, b0 = 0.73f, rg = 0.125f, rb = 0.195f, gr = 0.24f, gb = 0.075f,
+              br = -0.06f, bg = 0.21f;
+  const float gamma = 2.2f + (type == 1 ? 1.0f : -0.5f), inv = 1.0f / 2.2f;
+  for (unsigned c = 0; c < 65536; c++) {
+    const float r = powf((float)(c >> 11 & 31) / 31.0f, gamma);
+    const float g = powf((float)(c >> 6 & 31) / 31.0f, gamma);
+    const float b = powf((float)(c & 31) / 31.0f, gamma);
+    float rc = lum * (r0 * r + gr * g + br * b), gc = lum * (rg * r + g0 * g + bg * b), bc = lum * (rb * r + gb * g + b0 * b);
+    rc = powf(rc > 0.0f ? rc : 0.0f, inv);
+    gc = powf(gc > 0.0f ? gc : 0.0f, inv);
+    bc = powf(bc > 0.0f ? bc : 0.0f, inv);
+    const unsigned R = (unsigned)((rc > 1.0f ? 1.0f : rc) * 31.0f + 0.5f) & 31;
+    const unsigned G = (unsigned)((gc > 1.0f ? 1.0f : gc) * 31.0f + 0.5f) & 31;
+    const unsigned B = (unsigned)((bc > 1.0f ? 1.0f : bc) * 31.0f + 0.5f) & 31;
+    ccLut[c] = (uint16_t)(R << 11 | G << 6 | (G >> 4) << 5 | B);
+  }
+  ccType = type;
+}
