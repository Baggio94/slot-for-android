+  const bool original = settings.aspect == PD_ASPECT_ORIGINAL || (wideSupported && !wideSeen);
+  if (!companion && original && fw && fh && (PD_BE_IS_GBA() || !quickOpen)) {
     w = (int)fw;
     h = (int)fh;
   } else if (panelW) {
@@ -1672,7 +1678,7 @@ RETRO_API bool retro_load_game(const struct retro_game_info *g) {
   gameW = gameH = 0;
   quickSel = 0;
