slot. for Android: PokeDaisy's boot, intro and title screens whole on the screen.
EXPAND's canvas comes once the game first has a view past its edges; before
that (and after a reset, a state or a new game) the game's own frame, as
ORIGINAL. The view chosen stays EXPAND or ZOOM.

diff --git a/libretro/pd_libretro.c b/libretro/pd_libretro.c
index 899d1f7..2441af1 100644
--- a/libretro/pd_libretro.c
+++ b/libretro/pd_libretro.c
@@ -378,6 +378,9 @@ enum { PF_RUN, PF_WIDE, PF_DRAW, PF_PRESENT, PF_TOTAL, PF_CONV, PF_VIEW };
 
 /* EXPAND (the game-code layer, below): the window it rebuilt past the game's edges, when this frame has one. */
 static bool wideSupported, wideReady, fieldKnown;
+/* slot.: EXPAND shown once the game first has a view past its edges; its boot, intro and title screens before that
+ * at the game's own frame (as ORIGINAL), whole on the screen. Set again by a load, a state or a reset. */
+static bool wideSeen;
 static unsigned wideW, wideH;
 static uint32_t wideSource[240 * 160], wideFrame[PK_WIDE_MAX_VIEW_W * PK_WIDE_MAX_VIEW_H];
 static const uint16_t *base_pixels(void);
@@ -1256,6 +1259,8 @@ static void wide_tick(void) {
   PF_T(vw1);
   pf_add(PF_VIEW, vw1 - vw0);
   wideReady = !pk_wide_fault();
+  if (wideReady)
+    wideSeen = true; // the next canvas_update gives EXPAND its canvas
 }
 
