slot. for Android: EXPAND in a battle too.
The game's map or a battle shows the game has started: after a rewind or
a state resumed in a battle, EXPAND (or its zoom) comes back at once
rather than after the battle (patch 06 waited for the map). The battle
is the GBA's field state, or a Game Boy game's own flag as pk_wide_gb read
it. The boot, the intro, the title and the first menus stay ORIGINAL
(Siham 2026-11-27).

diff --git a/app/src/main/cpp/pk_wide.h b/app/src/main/cpp/pk_wide.h
index a08f951..6c1baf3 100644
--- a/app/src/main/cpp/pk_wide.h
+++ b/app/src/main/cpp/pk_wide.h
@@ -353,6 +353,8 @@ int pk_wide_gb_view(struct mCore* core, const uint32_t* frame, uint32_t* out, st
 /** pk_wide_glow's twin for a Game Boy game: the frame over its menus' bars. */
 int pk_wide_gb_glow(struct mCore* core, const uint32_t* frame, uint32_t* out, struct PkWideView view);
 int pk_wide_gb_scene(void);
+/** slot.: a Game Boy game in a battle, by its RAM, as the last frame was read. */
+int pk_wide_gb_in_battle(void);
 /** slot.: the Game Boy's screen is off (LCDC bit 7 clear) as the frame ends. 0 for anything else. */
 int pk_wide_gb_lcd_off(struct mCore* core);
 int pk_wide_gb_wants_close(void);
diff --git a/app/src/main/cpp/pk_wide_gb.c b/app/src/main/cpp/pk_wide_gb.c
index 8e9dfae..922733c 100644
--- a/app/src/main/cpp/pk_wide_gb.c
+++ b/app/src/main/cpp/pk_wide_gb.c
@@ -1410,6 +1410,7 @@ static bool gbFaded(const uint32_t* frame) {
 
 // --- the frame -----------------------------------------------------------------------------------------
 
+static bool gbLastBattle; // slot.: the game's battle flag as the last frame was read (pk_wide_gb_in_battle)
 static int gbSinceField = 1000;   // frames since the field (or a whole black / white frame) last showed
 static bool gbMixSnap; // pk_wide_gb_snap
 static int gbMix, gbLastScore = -1, gbLastMode = PK_WIDE_MODE_NONE, gbLastClose = 1, gbLastScene = PK_WIDE_SCENE_OFF;
@@ -1475,6 +1476,7 @@ void pk_wide_gb_reset(void) {
 }
 
 int pk_wide_gb_scene(void) { return gbLastScene; }
+int pk_wide_gb_in_battle(void) { return gbLastBattle; }
 int pk_wide_gb_lcd_off(struct mCore* core) {
     if (!core || core->platform(core) != mPLATFORM_GB || !core->board) return 0;
     return !(((struct GB*) core->board)->memory.io[GB_REG_LCDC] & 0x80);
@@ -1707,6 +1709,7 @@ int pk_wide_gb_view(struct mCore* core, const uint32_t* frame, uint32_t* out, st
     bool valid = best >= GB_MIN_SCORE;
     const struct GbSnap* now = &gbSnaps[cur];
     bool battle = now->ok && now->battle;
+    gbLastBattle = battle;
     bool faded = !valid && gbFaded(frame);
     // A door: between the fade and the new map, VRAM is rewritten a third a frame (the BG transfer) and matches nothing
     // for a few frames - still the field's business (ZOOM holds), not a menu screen to pull in for.
diff --git a/libretro/pd_libretro.c b/libretro/pd_libretro.c
index d12c11a..b92b6f3 100644
--- a/libretro/pd_libretro.c
+++ b/libretro/pd_libretro.c
@@ -1261,7 +1261,9 @@ static void wide_tick(void) {
   wideReady = !pk_wide_fault();
   // The first time the game is on its map (not the boot logo, the title or the first menus, which would only show
   // EXPAND's blurred sides): the next canvas_update gives EXPAND (or its zoom) its canvas.
-  if (wideReady && pk_wide_scene() == PK_WIDE_SCENE_FIELD)
+  // slot.: or in a battle: a rewind or a state resumed mid-battle stayed ORIGINAL until the battle was over.
+  const bool battle = fieldKnown ? (fieldFlags & PK_FIELD_BATTLE) != 0 : !PD_BE_IS_GBA() && pk_wide_gb_in_battle();
+  if (wideReady && (pk_wide_scene() == PK_WIDE_SCENE_FIELD || battle))
     wideSeen = true;
 }
 
