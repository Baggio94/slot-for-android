+/* slot.: a Game Boy game's blank screen between two black ones not shown. Pokemon Red, Blue and Yellow fade to black
+ * at each door, white the palette out (or turn the screen off) while the next map loads, then show black again: the
+ * blank screen flashed for six to eight frames. While the screen is off, or the game's frame is all one colour other
+ * than the one-colour frame before it, at most 12 frames in a row, the frame is painted that colour before anything
+ * draws it: this works at every canvas size, ZOOM's AUTO ZOOM IN changing it at the door included (a repeated frame
+ * can't, beta12). Screen off after a frame of several colours: that frame is repeated (GB_HOLD_REPEAT). */
+enum { GB_HOLD_NONE, GB_HOLD_PAINTED, GB_HOLD_REPEAT };
+static int gb_blank_hold(void) {
+  static bool lastUniform;
+  static uint16_t lastColour;
+  static int held;
+  static unsigned told;
+  if (PD_BE_IS_GBA()) {
+    held = 0;
+    lastUniform = false;
+    return GB_HOLD_NONE;
+  }
+  uint16_t *px = outputBuffer;
+  const uint16_t c = px[0];
+  bool uniform = true;
+  for (unsigned y = 0; y < 144 && uniform; y++)
+    for (unsigned x = 0; x < 160; x++)
+      if (px[y * 256 + x] != c) {
+        uniform = false;
+        break;
+      }
+  const bool off = pk_wide_gb_lcd_off(core) != 0;
+  if (held < 12 && (off || (uniform && lastUniform && c != lastColour))) {
+    if (!held && logCallback && told++ < 3)
+      logCallback(RETRO_LOG_WARN, "pokedaisy: %s, the frame before held\n", off ? "screen off" : "blank screen");
+    held++;
+    if (!lastUniform)
+      return GB_HOLD_REPEAT;
+    for (unsigned y = 0; y < 144; y++)
+      for (unsigned x = 0; x < 160; x++)
+        px[y * 256 + x] = lastColour;
+    return GB_HOLD_PAINTED; // what is on screen stays the one-colour frame before
+  }
+  held = 0;
+  lastUniform = uniform;
+  lastColour = c;
+  return GB_HOLD_NONE;
+}
