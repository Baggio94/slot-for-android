+/* slot.: a Game Boy game's blank screen between two black ones not shown. Pokemon Red, Blue and Yellow fade to black
+ * at each door, white the palette out (or turn the screen off) while the next map loads, then show black again: the
+ * blank screen flashed for six to eight frames. Held, the frame before stays (a dupe): while the screen is off, and
+ * while the game's frame is all one colour other than the one-colour frame before it, at most 12 frames in a row. */
+static bool gb_blank_hold(void) {
+  static bool lastUniform;
+  static uint16_t lastColour;
+  static int held;
+  static unsigned told;
+  if (PD_BE_IS_GBA()) {
+    held = 0;
+    lastUniform = false;
+    return false;
+  }
+  const uint16_t *px = outputBuffer;
+  const uint16_t c = px[0];
+  bool uniform = true;
+  for (unsigned y = 0; y < 144 && uniform; y++)
+    for (unsigned x = 0; x < 160; x++)
+      if (px[y * 256 + x] != c) {
+        uniform = false;
+        break;
+      }
+  const bool off = pk_wide_gb_lcd_off(core) != 0;
+  if (held < 12 && (off || (uniform && lastUniform && c != lastColour))) {
+    if (!held && logCallback && told++ < 3)
+      logCallback(RETRO_LOG_WARN, "pokedaisy: %s, the frame before held\n", off ? "screen off" : "blank screen");
+    held++;
+    return true; // what is on screen stays the one-colour frame before
+  }
+  held = 0;
+  lastUniform = uniform;
+  lastColour = c;
+  return false;
+}
